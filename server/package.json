{
  "name": "@carrot/mcp-server",
  "version": "1.0.0",
  "description": "An MCP server for the Carrot Protocol.",
  "main": "index.js",
  "type": "module",
  "bin": {
    "server": "./build/index.js"
  },
  "scripts": {
    "build": "npm i && tsc",
    "clean": "rm -rf build package-lock.json node_modules/",
    "start": "node build/index.js",
    "fmt": "prettier --write src/",
    "fmt:check": "prettier --check src/"
  },
  "files": [
    "build"
  ],
  "keywords": [
    "mcp",
    "carrot-protocol"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@carrot-protocol/http-client": "^0.2.76",
    "@coral-xyz/anchor": "^0.29.0",
    "@modelcontextprotocol/sdk": "^1.12.3",
    "express": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^20.12.12",
    "prettier": "^3.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
